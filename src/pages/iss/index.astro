---
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";

import IssTracker from "./_components/IssTracker";
---

<Layout title="ISS Orbit Calculator" compactTop>
  <Nav />
  <h1 class="text-3xl font-bold">ISS Orbit Calculator</h1>

  <IssTracker client:load />
</Layout>

<style is:global>
  @reference "tailwindcss";
  body {
    @apply mx-auto md:max-w-[75%] max-w-[90%];
  }
</style>

<style is:global>
  .iss-tracker {
    margin-top: 1.5rem;
    padding-bottom: 3rem;
  }
  .iss-tracker section {
    padding: 1.4rem 0;
    border-top: 1px solid #8885;
  }
  .iss-tracker h2 {
    font-size: 1.4rem;
    font-weight: 600;
    margin-bottom: 0.4rem;
  }
  .iss-tracker h3 {
    font-weight: 600;
    margin: 1rem 0 0.5rem;
  }
  .iss-muted {
    opacity: 0.7;
    font-size: 0.85rem;
  }
  .iss-stats,
  .iss-fields {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin: 1rem 0;
  }
  .iss-stats dt {
    font-size: 0.85rem;
    opacity: 0.7;
  }
  .iss-stats dd {
    font-family: monospace;
    font-size: 1.35rem;
  }
  .iss-fields label {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    flex: 1;
    min-width: 160px;
  }
  .iss-tracker input,
  .iss-tracker select,
  .iss-tracker button {
    border: 1px solid #8888;
    border-radius: 0.3rem;
    padding: 0.35rem 0.6rem;
    color: inherit;
    background: transparent;
  }
  .iss-tracker select option {
    color: #222;
    background: #fff;
  }
  .iss-tracker input {
    width: 100%;
  }
  .iss-tracker button {
    cursor: pointer;
  }
  .iss-tracker button:hover,
  .iss-tracker button[aria-pressed="true"] {
    background: #8882;
  }
  .iss-tracker button:disabled {
    opacity: 0.5;
    cursor: wait;
  }
  .iss-tracker :focus-visible {
    outline: 2px solid #60a5fa;
    outline-offset: 3px;
  }
  .iss-inline {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 1rem;
  }
  .iss-table-wrap {
    overflow-x: auto;
    margin: 1rem 0;
  }
  .iss-tracker table {
    border-collapse: collapse;
    width: 100%;
    font-size: 0.85rem;
    text-align: left;
  }
  .iss-tracker th,
  .iss-tracker td {
    padding: 0.65rem 0.7rem;
    border-bottom: 1px solid #8884;
    white-space: nowrap;
  }
  .iss-tracker th {
    font-weight: 600;
  }
  .iss-debug {
    border: 1px dashed #8888;
    border-radius: 0.4rem;
    padding: 1rem !important;
    margin-bottom: 1.5rem;
  }
  .iss-debug-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .iss-countdown {
    text-align: center;
  }
  .iss-countdown-value {
    font-family: monospace;
    font-size: clamp(2.5rem, 9vw, 5rem);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
    margin: 0.5rem 0;
  }
  .iss-active-tuning {
    margin: 0.8rem auto 1rem;
    padding: 0.7rem;
    border: 1px solid #8885;
    border-radius: 0.4rem;
    max-width: 30rem;
  }
  .iss-active-frequency {
    font-size: clamp(1.4rem, 5vw, 2.3rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .iss-countdown-active {
    background: #22c55e12;
    border-radius: 0.4rem;
  }
  .iss-countdown-active h2 {
    color: #15803d;
  }
  @media (prefers-color-scheme: dark) {
    .iss-countdown-active h2 {
      color: #86efac;
    }
  }
  .iss-mono {
    font-family: monospace;
  }
</style>
