---
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";

import IssTracker from "./_components/IssTracker";
---

<Layout title="ISS Orbit Calculator" compactTop>
  <Nav />
  <h1 class="text-3xl font-bold">ISS Orbit Calculator</h1>

  <IssTracker client:load />
</Layout>

<style is:global>
  @reference "tailwindcss";
  body {
    @apply mx-auto md:max-w-[75%] max-w-[90%];
  }
</style>
