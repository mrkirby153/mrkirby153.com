---
import Toc from "@components/Toc.astro";
import Post from "@layouts/Post.astro";
import { getCollection, render } from "astro:content";
import { type Component, ComponentType, ButtonStyle } from "../../types";

export async function getStaticPaths() {
  const blogEntries = await getCollection("posts");
  return blogEntries
    .filter((entry) => {
      return process.env.NODE_ENV !== "production" || !entry.data.draft;
    })
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);

const dayOfWeek = new Date(entry.data.date).toLocaleDateString("en-US", {
  weekday: "long",
  month: "long",
  day: "numeric",
  year: "numeric",
});

const component: Component = {
  type: ComponentType.Container,
  accent_color: 8469916,
  components: [
    {
      type: ComponentType.TextDisplay,
      content: `# ${entry.data.title}`,
    },
    {
      type: ComponentType.MediaGallery,
      items: [
        {
          media: {
            url: new URL(
              `/open-graph/post/${entry.id}.png`,
              Astro.site,
            ).toString(),
          },
          description: entry.data.title,
        },
      ],
    },
    {
      type: ComponentType.TextDisplay,
      content: entry.data.summary,
    },
    {
      type: ComponentType.Separator,
    },
    {
      type: ComponentType.ActionRow,
      components: [
        {
          type: ComponentType.Button,
          style: ButtonStyle.Link,
          label: "View Post",
          url: new URL(Astro.url.pathname, Astro.site).toString(),
        },
      ],
    },
  ],
};
---

<Post
  title={entry.data.title}
  description={entry.data.summary}
  opengraph={{
    "og:title": entry.data.title,
    "og:type": "article",
    "og:url": new URL(Astro.url.pathname, Astro.site).toString(),
    "og:image": `/open-graph/post/${entry.id}.png`,
    "twitter:card": "summary_large_image",
  }}
  component={component}
>
  {
    entry.data.draft && (
      <div class="bg-yellow-100 text-yellow-800 p-2 rounded-md mb-2">
        This post is a draft and is not yet published.
      </div>
    )
  }
  <span class="text-gray-300 text-sm italic">{dayOfWeek}</span>
  {
    !entry.data.hideToc && headings.length > 0 && (
      <div class="mt-3">
        <Toc toc={headings} />
      </div>
    )
  }
  <div class="prose dark:prose-invert max-w-none">
    <Content />
  </div>

  <hr class="mt-3" />
  <div class="flex justify-center">
    <a href="/post"> ← All Posts </a>
  </div>

  <style is:global>
    @reference "tailwindcss";
    body {
      @apply max-w-[90%] md:max-w-[50%];
      margin-left: auto;
      margin-right: auto;
    }
  </style>
</Post>
